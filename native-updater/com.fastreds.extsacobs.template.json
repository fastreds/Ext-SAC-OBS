{
  "name": "com.fastreds.extsacobs",
  "description": "Actualizador automatico de Ext Gestion SAC-UCR (Windows)",
  "path": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
  "type": "stdio",
  "args": [
    "-ExecutionPolicy",
    "Bypass",
    "-File",
    "HOST_SCRIPT_PATH"
  ],
  "allowed_origins": [
    "chrome-extension://EXTENSION_ID/"
  ]
}
